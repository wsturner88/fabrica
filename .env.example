# OPTIONAL - the Hub starts fine without a .env file.
# Copy to `.env` next to docker-compose.yml only if you need one of the settings below.
# Keep the real .env out of git and out of synced folders: it is listed in .gitignore.

# How many backup zips to keep per printer (default 5, minimum 1). Older ones are
# deleted after each successful backup.
# BACKUP_KEEP=5

# --- Printer secrets are NOT set here any more -----------------------------------
# Add printers (and their access codes / API keys / passwords) in the dashboard:
#   http://<host>:8271/dashboard  ->  Add your first printer.
# They are stored in the /data volume (secrets.json, mode 0600) and never shown again.
#
# The variables below are only for upgrading from the old config.yml setup: on the
# first start with an EMPTY /data volume, a mounted config.yml's printers are imported
# once and the variables named by its access_code_env / api_key_env are read from here
# and copied into the store. After that import they are ignored - rotate codes in
# the dashboard (Printers -> Edit). Names must match what your config.yml says.
# P1S_ACCESS_CODE=xxxxxxxx
# A1_ACCESS_CODE=xxxxxxxx
# MK4_API_KEY=xxxxxxxx

# --- API-key authentication ----------------------------------------------------------
# Default for the "API key check" setting: on | warn | off. A new install is `on`; a Hub that
# already had data starts in `warn`. A value saved in Settings > Security wins over this.
# BAMBU_MCP_API_AUTH=on
# Host names (besides IP addresses, localhost, *.local, *.lan, *.ts.net, single-label names) the
# dashboard may be opened through, comma separated - only needed behind a reverse proxy with its own name.
# BAMBU_MCP_ALLOWED_HOSTS=hub.example.com

# --- Spaghetti detection (optional add-on; full guide: docs/detection.md) ---------------------------
# Nothing here is needed unless you run the detector. The Hub is told where it is in Settings > Detection
# (address + token), so these variables only matter for the compose files and for "This machine" mode.
#
# DETECTOR_TOKEN   The shared secret between the Hub and the detector. Generate it once: openssl rand -hex 32
#                  It lives in the DETECTOR's .env (the adapter will not start without it). In "This machine"
#                  mode the Hub container reads it from the same .env; with the detector in a separate
#                  compose project, paste it into Settings > Detection > Detector token instead.
# DETECTOR_URL     Where the Hub finds the detector in "This machine" mode when Settings > Detection has no
#                  address typed in. Default http://detector:8080 (the compose service name). Reaching a detector
#                  that runs on the Docker HOST: http://host.docker.internal:8090 (see docs/detection.md).
# DETECTOR_BIND    (detector's compose file) address to publish the adapter on. 127.0.0.1 = this machine only
#                  (default); 0.0.0.0 for a detector box the Hub reaches over the network. Never the internet.
# DETECTOR_PORT    (detector's compose file) published port, default 8090
# DETECTOR_TOKEN=
# DETECTOR_URL=http://detector:8080
# DETECTOR_BIND=127.0.0.1
# DETECTOR_PORT=8090
